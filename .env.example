# Supabase project settings (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: Project Settings → API Keys → Secret keys. Used to invite and disable users.
SUPABASE_SECRET_KEY=sb_secret_...
# Public URL of the site, used in invitation and password reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional AI (server only; off until enabled in Settings). AI_PROVIDER is "anthropic" or
# "openai-compatible" (self-hosted or private cloud; then AI_BASE_URL is its chat completions URL).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
